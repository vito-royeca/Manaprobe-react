#!/bin/sh

# PROVIDE: manaprobe_react
# REQUIRE: LOGIN cleanvar
# KEYWORD: shutdown

# Put this script in /usr/local/etc/rc.d and make it executable. Then add
# "manaprobe_react_enable=YES" to /etc/rc.conf to enable it, i.e.:
# `cp bin/manaprobe_react /usr/local/etc/rc.d/manaprobe_react`
# `chmod a+x /usr/local/etc/rc.d/manaprobe_react`
# `service manaprobe_react enable`
# To start the service, run "service manaprobe_react start" or reboot the system.

PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"

. /etc/rc.subr

name="manaprobe_react"
workdir="/var/db/Manaprobe-react"
npm_cmd="/usr/local/bin/npm run start &"

start_cmd="${name}_start"
stop_cmd=":"

: ${dummy_svcj_options:=""}

manaprobe_react_start()
{
       su -m www -c "cd ${workdir} && ${npm_cmd}"
}

load_rc_config $name
run_rc_command "$1"